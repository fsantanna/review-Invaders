require "atmos"
val x = require "atmos.x"
require "atmos.env.pico"
val pico = require "pico"

pico.zet.font('./res/font.ttf', 8)
pico.zet(@{
    window = @{
        title="Menu screen",
        dim=@{'!', w=448, h=512}
    },

    view = @{
        grid=false,
        dim=@{'!', w=224, h=256}
    }
})

spawn {
    every :draw {
        ;; draw score counters. they never disappear
    }
}

val func Typewrite (text, pt) {
    var sub = "."

    spawn {
        every :draw  {
            pico.output.draw.text(sub, pt)
        }
    } 

    loop i in #text {
        until(i > #text)
        await @.100
        set sub = string.sub(text, 1, i)
    }

    emit [1] :ok
    await(false)
}

val func getPos(text, xrel, yrel) {
    val dim = pico.get.text(text, @{"%", h=0.03})
    val pos = pico.cv.pos(@{"%", x=xrel, y=yrel})
    return @{"!", x=pos.x-(dim.w/2), y=pos.y, h=dim.h, anchor="W"}
}


val tx1 = "PLAY"
val pt1 = getPos(tx1, 0.5, 0.25)
val tx2 = "SPACE INVADERS"
val pt2 = getPos(tx2, 0.5, 0.35)
val tx3 = "*SCORE ADVANCES TABLE*"
val pt3 = getPos(tx3, 0.5, 0.50)
val txa = "=? MYSTERY"
val pta = getPos(txa, 0.5, 0.60)
val txb = "=30 POINTS"
val ptb = getPos(txb, 0.5, 0.65)
val txc = "=20 POINTS"
val ptc = getPos(txc, 0.5, 0.70)
val txd = "=10 POINTS"
val ptd = getPos(txd, 0.5, 0.75)

await @1

watching :key.dn, :Escape {
    spawn Typewrite(tx1, pt1)
    await :ok

    spawn Typewrite(tx2, pt2)
    await :ok

    await @1

    spawn {
        every :draw {
            pico.output.draw.text(tx3, pt3)
            ;; ...
        }
    }

    spawn Typewrite(txa, pta)
    await :ok

    spawn Typewrite(txb, ptb)
    await :ok

    spawn Typewrite(txc, ptc)
    await :ok

    spawn Typewrite(txd, ptd)
    await :ok
}

watching :key.dn, :Escape {
    every :draw {
        pico.output.draw.text(tx1, pt1)
        pico.output.draw.text(tx2, pt2)
        pico.output.draw.text(tx3, pt3)
        pico.output.draw.text(txa, pta)
        pico.output.draw.text(txb, ptb)
        pico.output.draw.text(txc, ptc)
        pico.output.draw.text(txd, ptd)
    }
}

